* Values for event/idle; edge counts are extracted from RAW by TOOLS/analyze_outputs.py.
.meas tran SET_AMP PARAM AMP
.meas tran SET_FWHM_NS PARAM PW_NS
.meas tran SET_DELAY_NS PARAM DELAY_NS
.meas tran SET_NSIG PARAM N_SIG
.meas tran SET_NREF PARAM N_REF
.meas tran SET_SEED PARAM NSEED
.meas tran SMA1_EVENT_MIN MIN V(PMT1_SMA) FROM {T0-50n} TO {T0+350n}
.meas tran SMA2_EVENT_MIN MIN V(PMT2_SMA) FROM {T0-250n} TO {T0+550n}
.meas tran INPUT1_MIN MIN V(INM1) FROM 0 TO {TSTOP}
.meas tran INPUT1_MAX MAX V(INM1) FROM 0 TO {TSTOP}
.meas tran INPUT2_MIN MIN V(INM2) FROM 0 TO {TSTOP}
.meas tran INPUT2_MAX MAX V(INM2) FROM 0 TO {TSTOP}
.meas tran GAP1_AVG AVG (V(INM1)-V(TH1_OFF)) FROM 400n TO 700n
.meas tran GAP2_AVG AVG (V(INM2)-V(TH2_OFF)) FROM 400n TO 700n
.meas tran SMA1_IDLE_RMS RMS V(PMT1_SMA) FROM 400n TO 700n
.meas tran SMA2_IDLE_RMS RMS V(PMT2_SMA) FROM 400n TO 700n
.meas tran NS1_UNIT_RMS RMS V(NS1) FROM 400n TO 700n
.meas tran NS2_UNIT_RMS RMS V(NS2) FROM 400n TO 700n
.meas tran SIG1_NOMINAL_RMS PARAM N_SIG*NS1_UNIT_RMS
.meas tran SIG2_NOMINAL_RMS PARAM N_SIG*NS2_UNIT_RMS
.meas tran REF1_PIN_NOISE_RMS RMS V(TH1,TH1_QUIET) FROM 400n TO 700n
.meas tran REF2_PIN_NOISE_RMS RMS V(TH2,TH2_QUIET) FROM 400n TO 700n
.meas tran FAST_IDLE_MAX MAX V(COINC_FAST) FROM 300n TO 700n
.meas tran FAST_EVENT_MAX MAX V(COINC_FAST) FROM {T0-50n} TO {T0+350n}
.meas tran HOLD_EVENT_MAX MAX V(S_COINC) FROM {T0-50n} TO {T0+550n}
.meas tran STM_EVENT_MAX MAX V(STM_COINC) FROM {T0-50n} TO {T0+1500n}
.meas tran SINGLE1_MAX MAX V(STM_SING1) FROM 300n TO {TSTOP}
.meas tran SINGLE2_MAX MAX V(STM_SING2) FROM 300n TO {TSTOP}
.meas tran SOURCE1_FWHM TRIG V(PMT1_SRC) VAL={-K50*AMP/2} FALL=1 TD={T0-20n} TARG V(PMT1_SRC) VAL={-K50*AMP/2} RISE=1 TD={T0-20n}
.meas tran SOURCE2_FWHM TRIG V(PMT2_SRC) VAL={-K50*AMP*RATIO2/2} FALL=1 TD={T0+DELAY_NS*1n-20n} TARG V(PMT2_SRC) VAL={-K50*AMP*RATIO2/2} RISE=1 TD={T0+DELAY_NS*1n-20n}
.meas tran FAST_RISE1 WHEN V(COINC_FAST)=1.65 RISE=1 TD={T0-50n}
.meas tran STM_RISE1 WHEN V(STM_COINC)=1.65 RISE=1 TD={T0-50n}
